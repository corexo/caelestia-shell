#!/usr/bin/env python3
"""Chromium per project, so agents can drive the same browser you look at.

Each project in ~/.config/caelestia/projects.json gets its own Chromium profile
(~/.local/share/caelestia/browser/<name>) and debug port (its "port" field).

    project-browser open <name>   start or focus the project's browser (bar popout "+ Browser")
    project-browser port [name]   print the port; without name: project of the current folder
    project-browser mcp           MCP server for agents (chrome-devtools-mcp), attached to the
                                  browser of the project the agent runs in; starts it if needed.
                                  Outside a project it gets its own throwaway browser.
"""
import glob
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request

PROJECTS = os.path.expanduser("~/.config/caelestia/projects.json")
PROFILES = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "caelestia/browser")
# npx may be missing from PATH when an agent was started from the desktop; nvm keeps it here
NPX = shutil.which("npx") or max(glob.glob(os.path.expanduser("~/.nvm/versions/node/*/bin/npx")), default="npx")
MCP = [NPX, "-y", "chrome-devtools-mcp@latest"]


def projects() -> list:
    try:
        with open(PROJECTS) as f:
            return [p for p in json.load(f) if p.get("name") and p.get("port")]
    except (OSError, ValueError):
        return []


def by_name(name: str):
    return next((p for p in projects() if p["name"] == name), None)


def by_folder(folder: str):
    """Project whose folder contains `folder`, the deepest one wins."""
    folder = os.path.realpath(folder)
    hits = [p for p in projects() if folder == os.path.realpath(p["dir"]) or folder.startswith(os.path.realpath(p["dir"]) + os.sep)]
    return max(hits, key=lambda p: len(p["dir"]), default=None)


def running(port: int) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=1):
            return True
    except OSError:
        return False


def start(p: dict, new_window: bool) -> None:
    cmd = ["chromium", f"--user-data-dir={PROFILES}/{p['name']}", f"--remote-debugging-port={p['port']}"]
    if new_window:
        cmd.append("--new-window")
    # Same profile already open: Chromium hands the request to that instance and exits
    subprocess.Popen(cmd, cwd=p["dir"] if os.path.isdir(p["dir"]) else None, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    arg = sys.argv[2] if len(sys.argv) > 2 else ""

    if cmd == "open":
        p = by_name(arg)
        if not p:
            print(f"project-browser: unknown project {arg!r}", file=sys.stderr)
            return 1
        start(p, new_window=True)
        return 0

    if cmd == "port":
        p = by_name(arg) if arg else by_folder(os.getcwd())
        if not p:
            return 1
        print(p["port"])
        return 0

    if cmd == "mcp":
        # stdout belongs to the MCP protocol: messages go to stderr only
        p = by_folder(os.getcwd())
        if not p:
            # Google Chrome is not installed, so point it at Chromium
            os.execvp(MCP[0], MCP + ["--isolated", f"--executable-path={shutil.which('chromium') or 'chromium'}"])
        if not running(p["port"]):
            start(p, new_window=False)
            for _ in range(30):
                if running(p["port"]):
                    break
                time.sleep(0.5)
            else:
                print(f"project-browser: Chromium for {p['name']} did not open port {p['port']}", file=sys.stderr)
        os.execvp(MCP[0], MCP + [f"--browser-url=http://127.0.0.1:{p['port']}"])

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
