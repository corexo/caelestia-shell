#!/usr/bin/env python3
"""Shows an agent message as a notification that stays and accepts a typed answer.

    Claude Code (Notification hook, JSON on stdin):  agent-notify claude
    Codex (notify = [..., "codex"], JSON as last arg): agent-notify codex '<json>'

The answer is pasted into the agent's terminal (scripts/agent-reply).
"""
import json
import os
import subprocess
import sys

NAMES = {"claude": "Claude Code", "codex": "Codex"}


def main() -> int:
    agent = sys.argv[1] if len(sys.argv) > 1 else "agent"
    # The Claude desktop app shows its own notifications and has no terminal to paste into
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT") == "claude-desktop":
        return 0
    raw = sys.argv[2] if len(sys.argv) > 2 else sys.stdin.read()
    try:
        data = json.loads(raw or "{}")
    except ValueError:
        data = {}

    if agent == "codex" and data.get("type") not in (None, "agent-turn-complete"):
        return 0
    message = data.get("message") or data.get("last-assistant-message") or "Wartet auf deine Eingabe"
    name = NAMES.get(agent, agent)
    project = os.path.basename(data.get("cwd") or os.getcwd())

    ask = os.path.join(os.path.dirname(os.path.realpath(__file__)), "caelestia-ask")
    # caelestia-ask finds the terminal through its parent processes, so it must run as our child
    subprocess.run([ask, "--notify", "--agent", "--app-name", name, "-t", f"{name} · {project}", message[:500]],
                   timeout=10, check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
